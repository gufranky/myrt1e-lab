---
import '../styles/global.css';
---
<main>
  <section class="opening" aria-label="Myrtle opening scene">
    <img class="opening__scene" src="/assets/hero-wallpaper.webp" alt="A monochrome game-like opening scene" />
    <div class="opening__grade"></div>
    <header><span class="brand">myrt1e</span><span class="system">PRIVATE SYSTEM / 01</span></header>
    <div class="opening__copy">
      <p class="eyebrow">WUHAN UNIVERSITY · RENDERING / GAMES / AI</p>
      <h1>MYRTLE<br/>ARCHIVE</h1>
      <p class="intro">一个关于实时图形、可游玩世界与智能系统的个人空间。</p>
      <a class="enter" href="#content"><span></span>进入档案</a>
    </div>
    <div class="coords">N 30° 32′ 02″ · E 114° 21′ 18″</div>
  </section>
  <section id="content" class="placeholder"><p>内容区将在这里重写。</p></section>
</main>
