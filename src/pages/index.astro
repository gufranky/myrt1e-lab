---
import '../styles/global.css';
import Workspace from '../components/Workspace.astro';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="myrt1e 的个人数字自留地：渲染、游戏与 AI。" />
    <title>Myrtle Archive</title>
  </head>
  <body>
<main>
  <section class="hero-stage" aria-label="Myrtle Archive opening scene">
    <div class="hero" data-hero>
      <img class="hero__scene" src="/assets/hero-wallpaper.webp" alt="An industrial, game-like landscape" />
      <div class="hero__grade" aria-hidden="true"></div>
      <div class="hero__noise" aria-hidden="true"></div>
      <header class="masthead">
        <a class="masthead__brand" href="/" aria-label="Myrtle Archive home">myrt1e<span>_</span></a>
        <p>个人数字自留地</p><div class="masthead__state"><i></i> SYSTEM NOMINAL</div>
      </header>
      <div class="hero-copy" data-copy>
        <p class="hero-copy__kicker"><span></span> WUHAN UNIVERSITY / RENDERING · GAME · AI</p>
        <h1 aria-label="Myrt1e lab">
          <svg class="title-mark" viewBox="0 0 760 170" aria-hidden="true" focusable="false">
            <defs>
              <linearGradient id="title-gold" x1="0" y1="0" x2="0.07" y2="1">
                <stop offset="0%" stop-color="#fae5a0" />
                <stop offset="36%" stop-color="#f1d174" />
                <stop offset="48%" stop-color="#e8c464" />
                <stop offset="60%" stop-color="#f5d98a" />
                <stop offset="78%" stop-color="#ebc86b" />
                <stop offset="100%" stop-color="#dfb957" />
              </linearGradient>
            </defs>
            <text x="380" y="118" text-anchor="middle" fill="url(#title-gold)" stroke="#fff3ce" stroke-width="1.7" stroke-linejoin="round" paint-order="stroke fill">Myrt1e lab</text>
          </svg>
        </h1>
        <div class="command-line" aria-label="Personal archive terminal">
          <span class="command-line__mark" aria-hidden="true">&gt;_</span>
          <div><div class="command-line__dots" aria-hidden="true"><i></i><i></i><i></i></div><p><b>myrt1e@archive:~$</b> <span data-type-line>enter the private system</span><em aria-hidden="true"></em></p></div>
        </div>
        <button class="start-game" type="button" data-enter><span></span>Start game</button>
      </div>
      <span class="signal-mote mote-a" aria-hidden="true"></span><span class="signal-mote mote-b" aria-hidden="true"></span><span class="signal-mote mote-c" aria-hidden="true"></span>
      <button class="scroll-cue" type="button" data-enter aria-label="Scroll to archive content"><span>scroll to enter</span><b>⌄</b></button>
    </div>
  </section>
  <div class="signal-rail" aria-hidden="true"><span></span><b>NODE / 114.21.18</b><span></span></div>
  <Workspace />
</main>

<script>
  const enterControls = document.querySelectorAll('[data-enter]');
  const typeLine = document.querySelector('[data-type-line]');
  const clock = document.querySelector('[data-clock]');
  const lines = ['enter the private system', 'loading renderer / game / ai...', 'archive connection established.'];
  let lineIndex = 0;
  const enterArchive = () => document.querySelector('#main-content')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  enterControls.forEach((control) => control.addEventListener('click', enterArchive));
  window.addEventListener('wheel', (event) => { if (window.scrollY < 8 && event.deltaY > 10) enterArchive(); }, { passive: true });
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let characterIndex = 0;
  let deleting = false;
  let typingTimer = 0;
  const tickTyping = () => {
    if (!typeLine || document.hidden || reducedMotion.matches) return;
    const characters = Array.from(lines[lineIndex]);
    characterIndex += deleting ? -1 : 1;
    typeLine.textContent = characters.slice(0, characterIndex).join('');
    let delay = deleting ? 38 : 78;
    if (!deleting && characterIndex === characters.length) {
      deleting = true;
      delay = 1800;
    } else if (deleting && characterIndex === 0) {
      deleting = false;
      lineIndex = (lineIndex + 1) % lines.length;
      delay = 420;
    }
    typingTimer = window.setTimeout(tickTyping, delay);
  };
  const syncTyping = () => {
    window.clearTimeout(typingTimer);
    if (!typeLine) return;
    if (reducedMotion.matches) {
      typeLine.textContent = lines[0];
      characterIndex = 0;
      lineIndex = 0;
      deleting = false;
    } else if (!document.hidden) {
      typeLine.textContent = Array.from(lines[lineIndex]).slice(0, characterIndex).join('');
      typingTimer = window.setTimeout(tickTyping, 420);
    }
  };
  document.addEventListener('visibilitychange', syncTyping);
  reducedMotion.addEventListener('change', syncTyping);
  syncTyping();
  const updateClock = () => { if (clock) clock.textContent = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false }).format(new Date()); };
  updateClock(); window.setInterval(updateClock, 1000);
</script>
  </body>
</html>
