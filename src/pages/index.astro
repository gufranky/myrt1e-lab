---
import '../styles/global.css';
import Workspace from '../components/Workspace.astro';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="myrt1e 的个人数字自留地：渲染、游戏与 AI。" />
    <title>Myrt1e lab · Personal Archive</title>
  </head>
  <body>
<main>
  <section class="hero-stage" aria-label="Myrtle Archive opening scene">
    <div class="hero" data-hero>
      <img class="hero__scene" src="/assets/hero-wallpaper.webp" alt="An industrial, game-like landscape" />
      <div class="hero__grade" aria-hidden="true"></div>
      <div class="hero__noise" aria-hidden="true"></div>
      <header class="masthead">
        <a class="masthead__brand" href="/" aria-label="Myrtle Archive home">myrt1e<span>_</span></a>
        <p>个人数字自留地</p><div class="masthead__state"><i></i> SYSTEM NOMINAL</div>
      </header>
      <div class="hero-copy" data-copy>
        <p class="hero-copy__kicker"><span></span> WUHAN UNIVERSITY / RENDERING · GAME · AI</p>
        <h1 aria-label="Myrt1e lab">
          <svg class="title-mark" viewBox="0 0 760 170" aria-hidden="true" focusable="false">
            <defs>
              <linearGradient id="title-gold" x1="0" y1="0" x2="0.07" y2="1">
                <stop offset="0%" stop-color="#fae5a0" />
                <stop offset="36%" stop-color="#f1d174" />
                <stop offset="48%" stop-color="#e8c464" />
                <stop offset="60%" stop-color="#f5d98a" />
                <stop offset="78%" stop-color="#ebc86b" />
                <stop offset="100%" stop-color="#dfb957" />
              </linearGradient>
            </defs>
            <text x="380" y="118" text-anchor="middle" fill="url(#title-gold)" stroke="#fff3ce" stroke-width="1.7" stroke-linejoin="round" paint-order="stroke fill">Myrt1e lab</text>
          </svg>
        </h1>
        <div class="command-line" aria-label="Personal archive terminal">
          <span class="command-line__mark" aria-hidden="true">&gt;_</span>
          <div><div class="command-line__dots" aria-hidden="true"><i></i><i></i><i></i></div><p><b>myrt1e@archive:~$</b> <span data-type-line>enter the private system</span><em aria-hidden="true"></em></p></div>
        </div>
        <a class="start-game" href="#main-content" data-enter><span></span>Start game</a>
      </div>
      <span class="signal-mote mote-a" aria-hidden="true"></span><span class="signal-mote mote-b" aria-hidden="true"></span><span class="signal-mote mote-c" aria-hidden="true"></span>
      <a class="scroll-cue" href="#main-content" data-enter aria-label="Scroll to archive content"><span>scroll to enter</span><b>⌄</b></a>
    </div>
  </section>
  <div class="signal-rail" aria-hidden="true"><span></span><b>NODE / 114.21.18</b><span></span></div>
  <Workspace />
</main>

<script>
  const enterControls = document.querySelectorAll('[data-enter]');
  const typeLine = document.querySelector('[data-type-line]');
  const clock = document.querySelector('[data-clock]');
  const lines = ['enter the private system', 'loading renderer / game / ai...', 'archive connection established.'];
  let lineIndex = 0;
  const routeQuery = new URLSearchParams(location.search);
  const workspace = routeQuery.get('view') === 'workbench' || routeQuery.get('edit') === '1'
    ? document.querySelector<HTMLElement>('#workbench-content')
    : document.querySelector<HTMLElement>('#main-content');
  const workspaceAnchor = workspace?.id ? `#${workspace.id}` : '#main-content';
  enterControls.forEach((control) => control.setAttribute('href', workspaceAnchor));
  const workspaceTop = () => workspace ? workspace.getBoundingClientRect().top + window.scrollY : 0;
  const enterArchive = () => {
    if (!workspace) return;
    const behavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
    window.scrollTo({ top: Math.max(0, Math.round(workspaceTop())), behavior });
  };
  if (routeQuery.has('section') || routeQuery.get('view') === 'workbench' || routeQuery.get('edit') === '1') {
    const jumpToRoute = () => workspace?.scrollIntoView({ behavior: 'auto', block: 'start' });
    requestAnimationFrame(jumpToRoute);
    window.setTimeout(jumpToRoute, 120);
  }
  // Keep the anchor's native hash navigation as a no-JavaScript fallback.
  // The handler only upgrades it to a controlled smooth scroll.
  enterControls.forEach((control) => control.addEventListener('click', (event) => {
    event.preventDefault();
    enterArchive();
    history.replaceState(history.state, '', workspaceAnchor);
  }));
  let upwardIntent = 0;
  let intentTimer = 0;
  const returnToWorkspace = () => { const top = workspaceTop(); window.scrollTo({ top, behavior: 'smooth' }); };
  const returnToHero = () => { upwardIntent = 0; window.scrollTo({ top: 0, behavior: 'smooth' }); };
  window.addEventListener('wheel', (event) => {
    const top = workspaceTop();
    const atWorkspaceCard = Boolean(workspace) && window.scrollY >= top - 36 && window.scrollY <= top + 36;
    if (atWorkspaceCard && event.deltaY < 0) {
      event.preventDefault();
      upwardIntent += Math.abs(event.deltaY);
      window.clearTimeout(intentTimer);
      intentTimer = window.setTimeout(() => { upwardIntent = 0; }, 700);
      if (upwardIntent >= 180) returnToHero();
      else returnToWorkspace();
      return;
    }
    upwardIntent = 0;
    if (window.scrollY < 8 && event.deltaY > 10) {
      event.preventDefault();
      enterArchive();
    }
  }, { passive: false });
  let touchStartY = 0;
  let touchIntent = 0;
  window.addEventListener('touchstart', (event) => { touchStartY = event.touches[0]?.clientY ?? 0; touchIntent = 0; }, { passive: true });
  window.addEventListener('touchmove', (event) => {
    const currentY = event.touches[0]?.clientY ?? touchStartY;
    const delta = currentY - touchStartY;
    const top = workspaceTop();
    const atWorkspaceCard = Boolean(workspace) && window.scrollY >= top - 36 && window.scrollY <= top + 36;
    if (atWorkspaceCard && delta > 0) {
      event.preventDefault();
      touchIntent = Math.max(touchIntent, delta);
      returnToWorkspace();
    }
  }, { passive: false });
  window.addEventListener('touchend', () => {
    if (touchIntent >= 110) returnToHero();
    touchStartY = 0;
    touchIntent = 0;
  }, { passive: true });
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let characterIndex = 0;
  let deleting = false;
  let typingTimer = 0;
  const tickTyping = () => {
    if (!typeLine || document.hidden || reducedMotion.matches) return;
    const characters = Array.from(lines[lineIndex]);
    characterIndex += deleting ? -1 : 1;
    typeLine.textContent = characters.slice(0, characterIndex).join('');
    let delay = deleting ? 38 : 78;
    if (!deleting && characterIndex === characters.length) {
      deleting = true;
      delay = 1800;
    } else if (deleting && characterIndex === 0) {
      deleting = false;
      lineIndex = (lineIndex + 1) % lines.length;
      delay = 420;
    }
    typingTimer = window.setTimeout(tickTyping, delay);
  };
  const syncTyping = () => {
    window.clearTimeout(typingTimer);
    if (!typeLine) return;
    if (reducedMotion.matches) {
      typeLine.textContent = lines[0];
      characterIndex = 0;
      lineIndex = 0;
      deleting = false;
    } else if (!document.hidden) {
      typeLine.textContent = Array.from(lines[lineIndex]).slice(0, characterIndex).join('');
      typingTimer = window.setTimeout(tickTyping, 420);
    }
  };
  document.addEventListener('visibilitychange', syncTyping);
  reducedMotion.addEventListener('change', syncTyping);
  syncTyping();
  const updateClock = () => { if (clock) clock.textContent = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false }).format(new Date()); };
  updateClock(); window.setInterval(updateClock, 1000);
</script>
  </body>
</html>
