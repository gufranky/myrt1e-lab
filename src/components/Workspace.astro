<style>
  /* Yuimi-inspired translucent surfaces, with the local graphite/gold palette. */
  .editor {
    --edge: rgba(244, 229, 181, .25);
    --gold: #ebcb78;
    background: radial-gradient(ellipse at 12% 15%, #e4bd4e16, transparent 42%),
      radial-gradient(ellipse at 80% 70%, #ffffff09, transparent 50%), #171819;
    color: #e8e5dc;
  }
  .editor-bar {
    background: linear-gradient(120deg, #ffffff09, #ecd08408), #272829d9;
    border-bottom-color: var(--edge);
    box-shadow: inset 0 1px #ffffff18;
  }
  .editor-bar strong { font-family: 'Nunito', sans-serif; font-size: 17px; }
  .editor-logo {
    border-radius: 9px; color: #584722;
    background: linear-gradient(145deg, #fff0ba, #d8b661);
    border: 1px solid #fff4ccab; box-shadow: 0 3px 12px #d9ad4526;
  }
  .editor-bar button {
    border-radius: 999px; color: #eedda9; border-color: var(--edge);
    background: linear-gradient(135deg, #ffffff13, #e4be5910);
    box-shadow: inset 0 1px #ffffff19;
  }
  .editor-bar button:hover { background-color: #d9ad451c; }
  .library { background: #272829a3; border-color: var(--edge); padding-top: 26px; }
  .library h2 { color: #f2dfaa; letter-spacing: .02em; }
  .library h2 span { border-radius: 6px; padding: 3px 6px; background: #f2d78b12; color: #cfbd8c; }
  .library-item {
    border-radius: 12px; border-color: #efdfb52b;
    background: linear-gradient(130deg, #ffffff0d, #e9c46608);
    box-shadow: inset 0 1px #ffffff15, 0 6px 15px #00000015;
    transition: border-color 160ms, background-color 160ms;
  }
  .library-item:hover { background-color: #ecd08413; border-color: #ebcb7880; }
  .library-icon { border-radius: 10px; background: #eed58d13; border: 1px solid #e4c67733; padding: 5px; width: 36px; }
  .library-note { border-top-style: dashed; border-color: #d4c49430; color: #a7a599; }
  .workspace-tab { background: #292b2ca6; border-color: #e6d2a126; }
  .workspace-tab>span {
    margin: 5px 0 0 8px; height: calc(100% - 5px); padding: 9px 20px;
    border: 1px solid #eed38c42; border-bottom: none; border-radius: 9px 9px 0 0;
    color: #efd996; background: #ffffff09;
  }
  .workspace-canvas {
    background-color: transparent;
    background-image: radial-gradient(#e9dbb229 .8px, transparent .8px),
      radial-gradient(ellipse at 40% 10%, #e5bc5010, transparent 65%);
    background-size: 24px 24px, 100% 100%;
  }
  .workspace-canvas :global(.workspace-widget) {
    border: 1px solid #f5e5b94d; border-radius: 13px;
    background: linear-gradient(135deg, #ffffff08, #efd48b05), #292b2cdb;
    box-shadow: inset 0 0 0 1px #ffffff08, 0 16px 36px #00000035;
    backdrop-filter: blur(8px);
  }
  .workspace-canvas :global(.widget-head) {
    height: 43px; background: linear-gradient(110deg, #ffffff12, #e3bd5310);
    border-bottom: 1px solid #f2dfae26;
    box-shadow: inset 0 1px #ffffff20;
  }
  .workspace-canvas :global(.widget-drag) { color: #f0daa3; font-weight: 600; }
  .workspace-canvas :global(.widget-close) { color: #c5bfae; }
  .workspace-canvas :global(.widget-close:hover) { background: #e6c56e20; }
  .workspace-canvas :global(.location-visual) {
    margin: 10px 10px 0; border-radius: 8px;
    border: 1px solid #dcca9724; background: #20232290;
  }
  .workspace-canvas :global(.location-info h3) { color: #f3e6c3; }
  .workspace-canvas :global(.location-time) { font-family: 'Quicksand', sans-serif; font-weight: 600; }
  .workspace-canvas :global(.dog-marker-wrap) { background: transparent; border: 0; }
  .workspace-canvas :global(.dog-marker) { position: relative; width: 48px; height: 48px; display: grid; place-items: center; }
  .workspace-canvas :global(.dog-marker svg) { position: relative; z-index: 2; width: 34px; height: 34px; filter: drop-shadow(0 2px 3px #0009); }
  .workspace-canvas :global(.dog-marker i), .workspace-canvas :global(.dog-marker i::after) { position: absolute; inset: 7px; border: 1px solid #edc65d; border-radius: 50%; content: ''; animation: map-pulse 1.8s ease-out infinite; }
  .workspace-canvas :global(.dog-marker i::after) { inset: -7px; animation-delay: .55s; }
  .workspace-canvas :global(.widget-foot) { border-color: #d9c89926; background: #ffffff03; }
  .workspace-canvas :global(.widget-foot button) {
    border-radius: 999px; border-color: #ebcf8840; color: #eed9a2;
    background: linear-gradient(135deg, #ffffff0c, #e9c3660f);
  }
  .workspace-canvas :global(.widget-foot button:hover) { background-color: #e9c36620; }
  .workspace-canvas :global(.quote-body) { background: radial-gradient(ellipse at 85% 0%, #efd07810, transparent 70%); }
  .workspace-canvas :global(.intro-body) { flex: 1; padding: 22px 24px 16px; background: radial-gradient(ellipse at 0% 0%, #e8c86612, transparent 65%); }
  .workspace-canvas :global(.intro-profile) { display: flex; align-items: center; gap: 14px; padding-bottom: 17px; border-bottom: 1px solid #ead38c24; }
  .workspace-canvas :global(.intro-avatar) { position: relative; display: grid; place-items: center; flex: 0 0 58px; width: 58px; height: 58px; overflow: hidden; border: 2px solid #e7c164; border-radius: 50%; background: #3a3527; color: #f2d27b; font: 700 18px 'IBM Plex Mono', monospace; }
  .workspace-canvas :global(.intro-avatar)::after { content: attr(data-initials); position: absolute; }
  .workspace-canvas :global(.intro-avatar img) { position: relative; z-index: 1; width: 100%; height: 100%; object-fit: cover; }
  .workspace-canvas :global(.intro-eyebrow) { color: #a9a28e; font: 10px 'IBM Plex Mono', monospace; letter-spacing: .08em; }
  .workspace-canvas :global(.intro-profile h3) { margin: 5px 0 2px; color: #f3e6c3; font: 700 25px 'Nunito', sans-serif; }
  .workspace-canvas :global(.intro-profile p) { margin: 0; color: #aeb0a7; font-size: 12px; }
  .workspace-canvas :global(.intro-copy) { padding-top: 16px; color: #d3d1c7; font-size: 13px; line-height: 1.7; }
  .workspace-canvas :global(.intro-copy p) { margin: 0 0 10px; }
  .workspace-canvas :global(.intro-children) { min-height: 25px; margin-top: 12px; padding: 6px; border: 1px dashed #e7c16435; border-radius: 4px; color: #8e907f; font: 10px 'IBM Plex Mono', monospace; text-align: center; }
  .workspace-canvas :global(.workspace-child) { position: relative !important; left: auto !important; top: auto !important; width: 100% !important; height: auto !important; min-height: 0; margin-top: 4px; box-shadow: none; }
  .workspace-canvas :global(.workspace-child .widget-head) { height: 30px; }
  .workspace-canvas :global(.workspace-child .widget-resize) { display: none; }
  .workspace-canvas :global(.contact-body) { padding: 15px 18px 12px; background: radial-gradient(ellipse at 100% 0%, #e8c86612, transparent 70%); }
  .workspace-canvas :global(.contact-body h3) { margin: 4px 0 12px; color: #f3e6c3; font: 700 22px 'Nunito', sans-serif; }
  .workspace-canvas :global(.contact-links) { display: grid; grid-template-columns: repeat(3, 1fr); gap: 7px; }
  .workspace-canvas :global(.contact-links a) { display: flex; min-width: 0; align-items: center; flex-direction: column; gap: 3px; padding: 9px 8px; border: 1px solid #ead38c2e; border-radius: 4px; color: #e6e2d6; text-align: center; text-decoration: none; background: #ffffff05; transition: border-color .18s, background .18s; }
  .workspace-canvas :global(.contact-links a:hover) { border-color: #e7c164; background: #e7c16412; }
  .workspace-canvas :global(.contact-icon) { width: 22px; height: 22px; color: #e7c164; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.7; object-fit: contain; }
  .workspace-canvas :global(.contact-links strong) { overflow: hidden; font-size: 11px; text-overflow: ellipsis; white-space: nowrap; }
  .workspace-canvas :global(.contact-links small) { overflow: hidden; color: #96998f; font: 9px 'IBM Plex Mono', monospace; text-overflow: ellipsis; white-space: nowrap; }
  .workspace-canvas :global(.quote-symbol) { color: #e8cb7b; }
  .workspace-canvas :global(.widget-resize) { opacity: .5; }
  .workspace-canvas :global(.widget-resize:hover) { opacity: 1; }
  @keyframes map-pulse { 0% { transform: scale(.55); opacity: .9; } 70%, 100% { transform: scale(1.35); opacity: 0; } }
  .editor-status { border-color: var(--edge); background: #262829cc; }
  @media(max-width:700px) { .library { padding: 12px; } }
</style>

<style>
  /* Compact Unreal-style palette: hierarchy first, supporting copy only when useful. */
  .library { padding: 18px 10px; }
  .library h2 { padding: 0 6px 12px; margin-bottom: 0; border-bottom: 1px solid #ead38c26; font-size: 12px; text-transform: uppercase; letter-spacing: .08em; }
  .library-search { margin: 12px 0 17px; padding: 8px 9px; border: 1px solid #ffffff16; border-radius: 3px; color: #888b84; background: #11121466; font: 11px 'IBM Plex Mono', monospace; }
  .library-group { margin: 0 6px 6px; color: #9d9e95; font: 10px 'IBM Plex Mono', monospace; text-transform: uppercase; letter-spacing: .08em; }
  .library-item { display: grid; grid-template-columns: 28px minmax(0,1fr) 16px; align-items: center; gap: 9px; min-height: 42px; margin: 0 0 3px; padding: 7px 8px; border: 1px solid transparent; border-radius: 3px; background: transparent; box-shadow: none; }
  .library-item:hover { border-color: #e7c16455; background: #e7c16412; }
  .library-item strong { overflow: hidden; color: #deded7; font-size: 12px; font-weight: 500; text-overflow: ellipsis; white-space: nowrap; }
  .library-icon { display: grid; place-items: center; width: 28px; height: 28px; padding: 0; border: 1px solid #e7c16448; border-radius: 3px; color: #e7c164; background: #e7c1640e; font-size: 18px; }
  .library-item b { color: #8f918a; font-size: 13px; font-weight: 400; }
  .library-note { margin-top: 25px; padding: 12px 6px 0; border-top: 1px dashed #d4c49430; color: #777a73; font: 10px 'IBM Plex Mono', monospace; }
  @media(max-width:700px) { .library { padding: 10px; } .library-search { display: none; } .library-group { width: 100%; margin: 0 2px 2px; } .library-item { flex: 1 1 calc(50% - 4px); min-height: 39px; } .library-note { display: none; } }
</style>
