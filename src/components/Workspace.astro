  .workspace-canvas :global(.workspace-widget){position:absolute;display:flex;flex-direction:column;background:#27282a;border:1px solid #51524e;border-radius:7px;box-shadow:0 12px 28px #0004;overflow:hidden}.workspace-canvas :global(.workspace-widget.is-active){border-color:#e7c164;box-shadow:0 0 0 1px #e7c16455,0 15px 35px #0006}.workspace-canvas :global(.widget-head){height:39px;flex-shrink:0;display:flex;background:#303133;border-bottom:1px solid #464743}.workspace-canvas :global(.widget-drag){flex:1;text-align:left;padding:0 13px;color:#e3dac1;background:none;border:0;cursor:grab;touch-action:none;font-size:12px}.workspace-canvas :global(.widget-close){width:40px;border:0;background:none;color:#aaa;font-size:22px}.workspace-canvas :global(.widget-close:hover){color:#fff;background:#48413c}.workspace-canvas :global(.widget-content){flex:1;min-height:0;display:flex;flex-direction:column;overflow:auto}.workspace-canvas :global(.widget-resize){position:absolute;bottom:2px;right:2px;width:24px;height:24px;touch-action:none;cursor:nwse-resize;border:0;background:linear-gradient(135deg,transparent 54%,#c4ae69 55% 60%,transparent 61% 70%,#c4ae69 71% 76%,transparent 77%);opacity:.8}.workspace-canvas :global(.location-visual){flex:1;min-height:70px;position:relative;background:#202322;overflow:hidden}.workspace-canvas :global(.location-map){position:absolute;inset:0;background:#252725}.workspace-canvas :global(.location-map .leaflet-tile-pane){filter:grayscale(1) sepia(.25) hue-rotate(355deg) brightness(.62) contrast(1.15)}.workspace-canvas :global(.location-map .leaflet-control-attribution){display:none}.workspace-canvas :global(.location-visual>span){position:absolute;z-index:500;bottom:9px;left:13px;color:#d0c39d;font-size:9px;text-shadow:0 1px 3px #000}.workspace-canvas :global(.location-info){display:flex;justify-content:space-between;align-items:center;padding:15px}.workspace-canvas :global(h3){margin:0;font-size:24px;font-weight:600}.workspace-canvas :global(h3 small){font-size:13px;font-weight:400;color:#b5b7ac}.workspace-canvas :global(.location-info p){margin:5px 0 0;font-size:12px;color:#a9aca2}.workspace-canvas :global(.location-time){color:#ebcc76;font:20px monospace}.workspace-canvas :global(.widget-foot){display:flex;align-items:center;justify-content:space-between;gap:10px;min-height:38px;padding:6px 27px 6px 15px;border-top:1px solid #3c3e3b;color:#a7ab9e;font:10px monospace}.workspace-canvas :global(.widget-foot button){padding:7px 8px;border:1px solid #555549;background:#35362f;color:#e8d59f;border-radius:4px;font:12px sans-serif}.workspace-canvas :global(.quote-body){flex:1;padding:18px 24px;display:flex;flex-direction:column;justify-content:center}.workspace-canvas :global(.quote-symbol){font:45px Georgia;color:#e9c86f;height:32px}.workspace-canvas :global(blockquote){font-size:clamp(17px,2vw,23px);line-height:1.6;margin:10px 0;color:#eae5d6}.workspace-canvas :global(.quote-body p){margin:8px 0 0;color:#a8ab9f;font-size:12px;text-align:right}
