      content.querySelector<HTMLButtonElement>('[data-live2d-launch]')!.onclick=launch;
      content.querySelector<HTMLButtonElement>('[data-live2d-sleep]')!.onclick=()=>{if(liveAvatar){liveAvatar.sleep();if(statusText)statusText.textContent='角色休眠中';}else if(statusText)statusText.textContent='角色尚未启动';};
      launch();const instance=liveAvatar;const cleanup=()=>{if(!el.isConnected&&liveAvatar===instance){liveAvatar.destroy();liveAvatar=null;}};window.setInterval(cleanup,5000);
    }
    if(item.kind==='article'){
      const list=content.querySelector<HTMLElement>('[data-article-list]');
      const escape=(value:string)=>value.replace(/[&<>"']/g,char=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]||char));
      fetch('/api/blog').then(response=>response.ok?response.json():Promise.reject()).then(data=>{if(!list)return;const posts=Array.isArray(data.posts)?data.posts:[];list.innerHTML=posts.length?posts.map((post:any,index:number)=>`<a class="article-item" href="${escape(post.link||'https://blog.myrt1e.com')}" target="_blank" rel="noreferrer"><span class="article-check">${String(index+1).padStart(2,'0')}</span><span class="article-main"><strong>${escape(post.title||'未命名文章')}</strong><small>${escape(post.date||'')} · ${escape(post.category||'BLOG')}</small></span><span class="article-arrow">↗</span></a>`).join(''):'<div class="article-loading">暂无文章</div>';}).catch(()=>{if(list)list.innerHTML='<div class="article-loading">博客暂时不可用</div>';});
    }
    if(item.kind==='weather'){
      const city=content.querySelector<HTMLElement>('[data-weather-city]');const icon=content.querySelector<HTMLElement>('[data-weather-icon]');const temp=content.querySelector<HTMLElement>('[data-weather-temp]');const desc=content.querySelector<HTMLElement>('[data-weather-desc]');const daylight=content.querySelector<HTMLElement>('[data-weather-daylight]');const location=content.querySelector<HTMLElement>('[data-weather-location]');const source=content.querySelector<HTMLElement>('[data-weather-source]');const updated=content.querySelector<HTMLElement>('[data-weather-updated]');
      fetch('/api/weather').then(r=>r.ok?r.json():Promise.reject()).then(data=>{if(city)city.textContent=data.city||'未知城市';if(icon)icon.textContent=data.isDay?'☀':'☾';if(temp)temp.textContent=`${Math.round(data.temperature)}°`;if(desc)desc.textContent=data.description||'天气数据';if(daylight)daylight.textContent=data.isDay?'DAYLIGHT · 白昼':'NIGHT · 夜间';if(location)location.textContent=`${data.region||data.country||'IP GEOLOCATION'} · ${data.timezone||''}`;if(source)source.textContent='OPEN-METEO · LIVE';if(updated)updated.textContent=new Intl.DateTimeFormat('zh-CN',{hour:'2-digit',minute:'2-digit'}).format(new Date());}).catch(()=>{if(city)city.textContent='天气不可用';if(desc)desc.textContent='暂时无法读取天气';if(source)source.textContent='OFFLINE';});
    }
    if(item.kind==='system'){
      const cpu=content.querySelector<HTMLElement>('[data-system-cpu]');const mem=content.querySelector<HTMLElement>('[data-system-memory]');const cpuBar=content.querySelector<HTMLElement>('[data-system-cpu-bar]');const memBar=content.querySelector<HTMLElement>('[data-system-memory-bar]');const updated=content.querySelector<HTMLElement>('[data-system-updated]');const online=content.querySelector<HTMLElement>('[data-system-online]');
      const dot=(sel:string,ok:boolean)=>{const node=content.querySelector<HTMLElement>(sel);if(node)node.classList.toggle('is-offline',!ok);};
      const load=()=>fetch('/api/system').then(r=>r.ok?r.json():Promise.reject()).then(data=>{const c=Math.round(data.cpu||0),m=Math.round(data.memory||0);if(cpu)cpu.textContent=`${c}%`;if(mem)mem.textContent=`${m}%`;if(cpuBar)cpuBar.style.width=`${c}%`;if(memBar)memBar.style.width=`${m}%`;if(updated)updated.textContent=`UPTIME ${data.uptime||'--'}`;if(online)online.textContent='● ONLINE';dot('[data-service-api]',true);dot('[data-service-github]',!!data.services?.github);dot('[data-service-waka]',!!data.services?.wakatime);}).catch(()=>{if(online)online.textContent='● DEGRADED';dot('[data-service-api]',false);if(updated)updated.textContent='STATUS UNAVAILABLE';});load();const ticker=window.setInterval(()=>{if(!el.isConnected){clearInterval(ticker);return;}load();},60000);
    }
    function bind(control:HTMLElement, resizing:boolean) {
      control.addEventListener('pointerdown', e=>{if(e.button!==0)return;e.preventDefault();control.setPointerCapture(e.pointerId);el.style.zIndex=String(++topLayer);el.classList.add('is-active'); const start={...item},sx=e.clientX,sy=e.clientY;
        const move=(ev:PointerEvent)=>{const dx=ev.clientX-sx,dy=ev.clientY-sy;if(resizing){item.w=Math.min(800,Math.max(260,snap(start.w+dx)));item.h=Math.min(700,Math.max(250,snap(start.h+dy)));}else{const peer=snapToPeers(item,start.x+dx,start.y+dy);item.x=Math.min(2000,Math.max(0,Math.abs(peer.x-(start.x+dx))<=14?peer.x:snap(start.x+dx)));item.y=Math.min(2000,Math.max(0,Math.abs(peer.y-(start.y+dy))<=14?peer.y:snap(start.y+dy)));}position(el,item);extent();};
        const end=()=>{control.removeEventListener('pointermove',move);control.removeEventListener('pointerup',end);control.removeEventListener('pointercancel',end);el.classList.remove('is-active');save();};control.addEventListener('pointermove',move);control.addEventListener('pointerup',end);control.addEventListener('pointercancel',end);
      });
      control.addEventListener('keydown',e=>{if(!['ArrowLeft','ArrowRight','ArrowUp','ArrowDown'].includes(e.key))return;e.preventDefault();const dx=e.key==='ArrowLeft'?-8:e.key==='ArrowRight'?8:0,dy=e.key==='ArrowUp'?-8:e.key==='ArrowDown'?8:0;if(resizing){item.w=Math.max(260,Math.min(800,item.w+dx));item.h=Math.max(250,Math.min(700,item.h+dy));}else{item.x=Math.max(0,Math.min(2000,item.x+dx));item.y=Math.max(0,Math.min(2000,item.y+dy));}position(el,item);extent();save();});
    }
    bind(handle,false);bind(resize,true);clock();
  }
  function add(kind:Kind,x=40+items.length*24,y=40+items.length*24,parentId?:string){if(items.length>=20){status.textContent='最多放置 20 个控件';return;}const item={id:crypto.randomUUID(),kind,x:Math.max(0,x),y:Math.max(0,y),w:kind==='intro'?440:kind==='contact'?390:kind==='time'?390:kind==='nowplaying'?360:kind==='terminal'?420:kind==='stack'?300:kind==='dashboard'?480:kind==='live2d'?380:kind==='article'?520:360,h:kind==='location'?320:kind==='intro'?310:kind==='contact'?230:kind==='time'?210:kind==='nowplaying'?270:kind==='terminal'?270:kind==='stack'?240:kind==='dashboard'?360:kind==='live2d'?340:kind==='article'?360:290,parentId};items.push(item);mount(item);extent();save();}
  document.querySelectorAll<HTMLButtonElement>('[data-add]').forEach(button=>{button.onclick=()=>add(button.dataset.add as Kind);button.ondragstart=e=>{e.dataTransfer?.setData('text/plain',button.dataset.add!);};});
  canvas.ondragover=e=>{e.preventDefault();};canvas.ondrop=e=>{e.preventDefault();const kind=e.dataTransfer?.getData('text/plain');if(kind==='location'||kind==='quote'||kind==='intro'||kind==='contact'||kind==='time'||kind==='nowplaying'||kind==='terminal'||kind==='stack'||kind==='dashboard'||kind==='live2d'||kind==='article'||kind==='weather'||kind==='system'){const target=(e.target as HTMLElement).closest<HTMLElement>('[data-item-kind="intro"]');const r=canvas.getBoundingClientRect();const parentId=kind==='contact'&&target ? target.dataset.itemId : undefined;add(kind,e.clientX-r.left,e.clientY-r.top,parentId);if(parentId)status.textContent='联系我已嵌入个人简介';}};
  document.querySelector<HTMLButtonElement>('[data-reset]')!.onclick=()=>{canvas.querySelectorAll('.workspace-widget').forEach(el=>el.remove());items=defaults();items.forEach(mount);arrange();};
  function arrange(persist=true){
    const width=Math.max(320,canvas.parentElement!.clientWidth);
    const columns=width>=1180?3:width>=780?2:1;
    const gap=20, padding=24, w=Math.min(520,(width-padding*2-gap*(columns-1))/columns);
    const heights=Array(columns).fill(padding);
    const order:Kind[]=['intro','article','nowplaying','dashboard','live2d','location','time','stack','quote','terminal','contact'];
    [...items].filter(i=>!i.parentId).sort((a,b)=>order.indexOf(a.kind)-order.indexOf(b.kind)).forEach(item=>{
      const column=heights.indexOf(Math.min(...heights));
      item.x=padding+column*(w+gap);item.y=heights[column];item.w=w;
      item.h=item.kind==='intro'?590:item.kind==='nowplaying'?470:item.kind==='dashboard'?420:item.kind==='live2d'?380:item.kind==='location'?330:item.kind==='time'?280:item.kind==='stack'?520:310;
      heights[column]+=item.h+gap;
      const element=Array.from(canvas.querySelectorAll<HTMLElement>('[data-item-id]')).find(el=>el.dataset.itemId===item.id);
      if(element)position(element,item);
    });
    extent();window.dispatchEvent(new Event('resize'));if(persist)save();
  }
  document.querySelector<HTMLButtonElement>('[data-arrange]')!.onclick=()=>arrange();
  document.querySelector<HTMLInputElement>('[data-widget-search]')!.oninput=e=>{
    const query=(e.target as HTMLInputElement).value.trim().toLowerCase();
    document.querySelectorAll<HTMLButtonElement>('[data-add]').forEach(button=>{button.hidden=!button.textContent!.toLowerCase().includes(query);});
  };
  const nativeFetch=window.fetch.bind(window);window.fetch=(input,init)=>{const url=typeof input==='string'?input:input instanceof URL?input.toString():input.url;if(url.includes('ipwho.is/')||url.includes('ipinfo.io/json'))return nativeFetch('/api/location',init);return nativeFetch(input,init);};
  items.filter(i=>!i.parentId).forEach(mount);items.filter(i=>i.parentId).forEach(mount);extent();
  try{if(!localStorage.getItem('myrt1e-workspace-polish-v2')){localStorage.setItem('myrt1e-workspace-layout-backup',JSON.stringify(items));arrange();localStorage.setItem('myrt1e-workspace-polish-v2','1');}}catch{}
  window.setInterval(clock,30000);
</script>
