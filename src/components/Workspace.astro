<section id="main-content" class="editor" aria-label="个人工作台">
  <header class="editor-bar"><div><span class="editor-logo">M</span><strong>Myrt1e lab</strong><span class="editor-divider">/</span><span>个人工作台</span></div><button data-reset>恢复默认布局</button></header>
  <div class="editor-body">
    <aside class="library"><h2>控件库 <span>04</span></h2><div class="library-search">⌕&nbsp; 搜索控件</div><p class="library-group">信息</p>
      <button class="library-item" draggable="true" data-add="location"><span class="library-icon">⌖</span><strong>地理位置</strong><b>+</b></button>
      <button class="library-item" draggable="true" data-add="quote"><span class="library-icon">“</span><strong>一言</strong><b>+</b></button>
      <button class="library-item" draggable="true" data-add="intro"><span class="library-icon">◎</span><strong>自我介绍</strong><b>+</b></button>
      <button class="library-item" draggable="true" data-add="contact"><span class="library-icon">↗</span><strong>联系我</strong><b>+</b></button>
      <div class="library-note">拖入工作区以添加</div>
    </aside>
    <div class="workspace-shell"><div class="workspace-tab"><span>▧ &nbsp; 我的空间</span><small>拖动标题移动 · 拖动右下角缩放</small></div><div class="canvas-scroll"><div class="workspace-canvas" data-canvas><p class="canvas-empty" data-empty hidden>工作区为空<br/><small>从左侧添加你的第一个控件</small></p></div></div></div>
  </div>
  <footer class="editor-status"><span><i></i> 本地工作区</span><span data-save-status role="status">布局自动保存在此浏览器</span></footer>
</section>

<template id="location-widget"><div class="location-visual"><div class="location-map" data-location-map aria-label="实时 IP 地理位置地图"></div><span>IP GEOLOCATION · © OpenStreetMap</span></div><div class="location-info"><div><h3 data-location-city>定位中… <small data-location-region>IP GEO</small></h3><p data-location-country>正在获取网络位置</p></div><span class="location-time" data-wuhan-time>--:--</span></div><div class="widget-foot"><span data-location-coordinates>--</span><span data-location-zone>WAITING</span></div></template>
<template id="quote-widget"><div class="quote-body"><span class="quote-symbol">“</span><blockquote data-quote></blockquote><p>— <span data-author></span></p></div><div class="widget-foot"><span>一言 / 本地摘句</span><button data-next-quote>换一句 ↻</button></div></template>
<template id="intro-widget"><div class="intro-body"><div class="intro-profile"><div class="intro-avatar" data-initials="GF"><img data-profile-avatar src="https://github.com/gufranky.png?size=256" alt="gufranky 的 GitHub 头像" loading="lazy" /></div><div><span class="intro-eyebrow">PLAYER PROFILE / 01</span><h3>gufranky</h3><p>武汉大学 · 大四</p></div></div><div class="intro-copy"><p>我是来自武汉大学的大四学生，主要研究计算机图形学（渲染方向）、游戏开发与 AI。</p><p>目前专注于 UE5 渲染开发与 CS 游戏插件开发，很多项目都源于兴趣使然。</p><p>欢迎与我沟通。</p></div><div class="intro-children" data-child-drop><span>将子控件拖到这里</span></div></div><div class="widget-foot"><span>个人简介 / PROFILE</span><span>GITHUB · GUFRANKY</span></div></template>
<template id="contact-widget"><div class="contact-body"><span class="intro-eyebrow">CONTACT CHANNELS / 03</span><h3>联系我</h3><div class="contact-links"><a href="https://space.bilibili.com/186605312" target="_blank" rel="noreferrer"><svg class="contact-icon" viewBox="0 0 24 24" aria-label="哔哩哔哩"><path d="M8 5 6 2M16 5l2-3"/><rect x="3" y="5" width="18" height="15" rx="4"/><path d="M8 11v3M16 11v3M9 17h6"/></svg><strong>哔哩哔哩</strong><small>186605312</small></a><a href="https://github.com/gufranky" target="_blank" rel="noreferrer"><svg class="contact-icon" viewBox="0 0 24 24" aria-label="GitHub"><path d="M12 2.5a9.5 9.5 0 0 0-3 18.51c.48.09.65-.21.65-.46v-1.7c-2.66.58-3.22-1.13-3.22-1.13-.44-1.12-1.08-1.42-1.08-1.42-.88-.6.07-.59.07-.59.97.07 1.48 1 1.48 1 .87 1.48 2.28 1.05 2.84.8.09-.62.34-1.05.62-1.29-2.12-.24-4.35-1.06-4.35-4.72 0-1.04.37-1.89.98-2.56-.1-.24-.43-1.21.09-2.52 0 0 .8-.26 2.62.98a9.1 9.1 0 0 1 4.77 0c1.82-1.24 2.62-.98 2.62-.98.52 1.31.19 2.28.09 2.52.61.67.98 1.52.98 2.56 0 3.67-2.23 4.48-4.36 4.72.34.29.65.85.65 1.72v2.54c0 .25.17.55.66.46A9.5 9.5 0 0 0 12 2.5Z"/></svg><strong>GitHub</strong><small>gufranky</small></a><a href="https://steamcommunity.com/id/frankygu/" target="_blank" rel="noreferrer"><svg class="contact-icon" viewBox="0 0 24 24" aria-label="Steam"><circle cx="12" cy="12" r="9"/><circle cx="16.5" cy="8" r="2.5"/><circle cx="8" cy="15.5" r="2.5"/><path d="m10 14 4.6-4.2"/></svg><strong>Steam</strong><small>frankygu</small></a></div></div><div class="widget-foot"><span>联系我 / CHANNELS</span><span>OPEN LINK ↗</span></div></template>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';
  type Kind = 'location' | 'quote' | 'intro' | 'contact';
  type Item = {id:string; kind:Kind; x:number; y:number; w:number; h:number; parentId?:string};
  const canvas = document.querySelector<HTMLElement>('[data-canvas]')!;
  const status = document.querySelector<HTMLElement>('[data-save-status]')!;
  const key = 'myrt1e-workspace-v1';
  const defaults = (): Item[] => [{id:'home',kind:'location',x:32,y:32,w:360,h:320},{id:'words',kind:'quote',x:424,y:96,w:360,h:290},{id:'profile',kind:'intro',x:220,y:430,w:440,h:310},{id:'contact',kind:'contact',x:690,y:450,w:390,h:230}];
  let items = defaults();
  let topLayer = 1;
  const quotes = [['千里之行，始于足下。','《老子》'],['不积跬步，无以至千里。','《荀子·劝学》'],['山重水复疑无路，柳暗花明又一村。','陆游'],['纸上得来终觉浅，绝知此事要躬行。','陆游']];
  try { const saved = JSON.parse(localStorage.getItem(key) || 'null'); if (Array.isArray(saved)) items = saved.filter((v) => v && typeof v.id === 'string' && ['location','quote','intro','contact'].includes(v.kind) && ['x','y','w','h'].every(k => Number.isFinite(v[k]))).slice(0,20).map(v => ({...v,x:Math.max(0,Math.min(2000,v.x)),y:Math.max(0,Math.min(2000,v.y)),w:Math.max(260,Math.min(800,v.w)),h:Math.max(250,Math.min(700,v.h))})); } catch {}
  if (!items.some(item => item.kind === 'intro')) items.push({id:'profile',kind:'intro',x:220,y:430,w:440,h:310});
  if (!items.some(item => item.kind === 'contact')) items.push({id:'contact',kind:'contact',x:690,y:450,w:390,h:230});
  function save() { try { localStorage.setItem(key,JSON.stringify(items)); status.textContent = '布局已保存到此浏览器'; } catch { status.textContent = '无法保存，当前布局仅本次有效'; } }
  function extent() { canvas.style.minWidth = `${Math.max(820,...items.map(i=>i.x+i.w+32))}px`; canvas.style.minHeight = `${Math.max(640,...items.map(i=>i.y+i.h+32))}px`; document.querySelector<HTMLElement>('[data-empty]')!.hidden = items.length > 0; }
  function position(el:HTMLElement,item:Item) { Object.assign(el.style,{left:`${item.x}px`,top:`${item.y}px`,width:`${item.w}px`,height:`${item.h}px`}); }
  function clock() { document.querySelectorAll<HTMLElement>('[data-wuhan-time]').forEach(el => { const timeZone = el.dataset.timezone || 'Asia/Shanghai'; el.textContent = new Intl.DateTimeFormat('en-GB',{timeZone,hour:'2-digit',minute:'2-digit'}).format(new Date()); }); }
  function mount(item:Item) {
    const el = document.createElement('article'); el.className = `workspace-widget${item.parentId ? ' workspace-child' : ''}`; el.dataset.itemId=item.id; el.dataset.itemKind=item.kind; position(el,item);
    const head = document.createElement('div'); head.className = 'widget-head';
    const handle = document.createElement('button'); handle.className='widget-drag'; handle.textContent=item.kind === 'location' ? '⌖  地理位置' : item.kind === 'quote' ? '“  一言' : item.kind === 'intro' ? '◎  个人简介' : '↗  联系我'; handle.setAttribute('aria-label','移动控件：拖动或使用方向键');
    const close=document.createElement('button'); close.className='widget-close';close.textContent='×';close.setAttribute('aria-label','移除此控件'); head.append(handle,close);
    const content=document.createElement('div');content.className='widget-content';content.append((document.getElementById(`${item.kind}-widget`) as HTMLTemplateElement).content.cloneNode(true));
    const resize=document.createElement('button');resize.className='widget-resize';resize.setAttribute('aria-label','调整大小：拖动或使用方向键');
    el.append(head,content,resize);const parentDrop=item.parentId ? canvas.querySelector<HTMLElement>(`[data-item-id="${item.parentId}"] [data-child-drop]`) : null;(parentDrop || canvas).append(el);
    close.onclick=()=>{items=items.filter(i=>i!==item && i.parentId!==item.id);el.remove();extent();save();};
    if(item.kind==='quote'){
      let n=0;
      const update=(text=quotes[n][0],author=quotes[n][1])=>{content.querySelector('[data-quote]')!.textContent=text;content.querySelector('[data-author]')!.textContent=author;};
      update();
      const fetchQuote=async()=>{const button=content.querySelector<HTMLButtonElement>('[data-next-quote]');if(button)button.disabled=true;try{const response=await fetch('https://v1.hitokoto.cn/?c=i&c=k',{headers:{Accept:'application/json'}});if(!response.ok)throw new Error('quote request failed');const data=await response.json();update(data.hitokoto || quotes[n][0], data.from_who || data.from || '一言');}catch{n=(n+1)%quotes.length;update();}finally{if(button)button.disabled=false;}};
      content.querySelector<HTMLButtonElement>('[data-next-quote]')!.onclick=fetchQuote;
      fetchQuote();
    }
    if(item.kind==='location'){
      const mapTarget=content.querySelector<HTMLElement>('[data-location-map]');
      const map=mapTarget ? L.map(mapTarget,{zoomControl:false,attributionControl:false,scrollWheelZoom:false,dragging:false,doubleClickZoom:false,keyboard:false}).setView([20,0],2) : null;
      if(map) L.tileLayer('https://tile.openstreetmap.de/{z}/{x}/{y}.png',{maxZoom:19}).addTo(map);
      const fetchLocation=async()=>{const city=content.querySelector('[data-location-city]');const region=content.querySelector('[data-location-region]');const country=content.querySelector('[data-location-country]');const coordinates=content.querySelector('[data-location-coordinates]');const zone=content.querySelector('[data-location-zone]');const localTime=content.querySelector<HTMLElement>('[data-wuhan-time]');try{let data:any;let provider='';for(const endpoint of ['https://ipwho.is/','https://ipinfo.io/json']){try{const response=await fetch(endpoint,{headers:{Accept:'application/json'}});if(!response.ok)continue;const raw=await response.json();if(endpoint.includes('ipwho')&&!raw.success)continue;const [lat,lon]=endpoint.includes('ipwho')?[Number(raw.latitude),Number(raw.longitude)]:String(raw.loc||'').split(',').map(Number);if(!Number.isFinite(lat)||!Number.isFinite(lon))continue;data={city:raw.city,region:raw.region,country:raw.country,latitude:lat,longitude:lon,timezoneId:endpoint.includes('ipwho')?raw.timezone?.id:raw.timezone,utc:endpoint.includes('ipwho')?raw.timezone?.utc:''};provider=endpoint;break;}catch{}}if(!data)throw new Error('location unavailable');if(city)city.firstChild!.textContent=`${data.city || '未知城市'} `;if(region)region.textContent=data.region || data.country || '网络出口';if(country)country.textContent=`${data.region || ''} · ${data.country || ''}`;if(coordinates)coordinates.textContent=`${Math.abs(data.latitude).toFixed(2)}° ${data.latitude >= 0 ? 'N' : 'S'} / ${Math.abs(data.longitude).toFixed(2)}° ${data.longitude >= 0 ? 'E' : 'W'}`;if(zone)zone.textContent=data.utc ? `UTC ${data.utc}` : (data.timezoneId || 'IP TIMEZONE');if(localTime&&data.timezoneId){localTime.dataset.timezone=data.timezoneId;clock();}if(map){map.setView([data.latitude,data.longitude],8,{animate:true});const dogIcon=L.divIcon({className:'dog-marker-wrap',html:'<div class="dog-marker"><i></i><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M14 20 9 13l2-5 8 6c3-1 7-1 10 0l8-6 2 5-5 7v10c0 7-5 11-12 11S10 37 10 30V20Z" fill="#edc65d" stroke="#2c2d2b" stroke-width="2"/><circle cx="19" cy="26" r="2" fill="#2c2d2b"/><circle cx="29" cy="26" r="2" fill="#2c2d2b"/><path d="M21 32q3 3 6 0" fill="none" stroke="#2c2d2b" stroke-width="2" stroke-linecap="round"/></svg></div>',iconSize:[48,48],iconAnchor:[24,24]});L.marker([data.latitude,data.longitude],{icon:dogIcon,keyboard:false}).addTo(map);window.setTimeout(()=>map.invalidateSize(),80);}status.textContent=`IP 定位已更新 · ${provider.includes('ipinfo') ? '备用接口' : 'ipwho.is'}`;}catch{if(city)city.firstChild!.textContent='定位失败 ';if(region)region.textContent='NETWORK';if(country)country.textContent='IP 服务暂不可用';if(coordinates)coordinates.textContent='--';if(zone)zone.textContent='UNAVAILABLE';if(localTime)localTime.textContent='--:--';status.textContent='IP 定位暂不可用，请检查网络';}};fetchLocation();
    }
    if(item.kind==='location'){
      const fallbackLocation=async()=>{try{const response=await fetch('https://get.geojs.io/v1/ip/geo.json',{headers:{Accept:'application/json'}});if(!response.ok)throw new Error('fallback location failed');const data=await response.json();const city=content.querySelector('[data-location-city]');const region=content.querySelector('[data-location-region]');const country=content.querySelector('[data-location-country]');const coordinates=content.querySelector('[data-location-coordinates]');const zone=content.querySelector('[data-location-zone]');const localTime=content.querySelector<HTMLElement>('[data-wuhan-time]');const current=city?.textContent || '';if(current&&!current.startsWith('定位中')&&!current.startsWith('定位失败'))return;const lat=Number(data.latitude),lon=Number(data.longitude),timeZone=data.timezone || '';if(city)city.firstChild!.textContent=`${data.city || '未知城市'} `;if(region)region.textContent=data.region || data.country || '网络出口';if(country)country.textContent=`${data.region || ''} · ${data.country_code || data.country || ''}`;if(coordinates)coordinates.textContent=`${Math.abs(lat).toFixed(2)}° ${lat >= 0 ? 'N' : 'S'} / ${Math.abs(lon).toFixed(2)}° ${lon >= 0 ? 'E' : 'W'}`;if(zone)zone.textContent=timeZone || 'IP TIMEZONE';if(localTime&&timeZone){localTime.dataset.timezone=timeZone;clock();}status.textContent='IP 定位已更新 · GeoJS 备用接口';}catch{}};fallbackLocation();
      const jsonpLocation=()=>{const callback=`geo_${Date.now()}`;const script=document.createElement('script');const finish=(data:any)=>{const city=content.querySelector('[data-location-city]');const region=content.querySelector('[data-location-region]');const country=content.querySelector('[data-location-country]');const coordinates=content.querySelector('[data-location-coordinates]');const zone=content.querySelector('[data-location-zone]');const localTime=content.querySelector<HTMLElement>('[data-wuhan-time]');const current=city?.textContent || '';if(current&&!current.startsWith('定位中')&&!current.startsWith('定位失败'))return;const lat=Number(data.latitude),lon=Number(data.longitude);if(city)city.firstChild!.textContent=`${data.city || '未知城市'} `;if(region)region.textContent=data.region || data.country || '网络出口';if(country)country.textContent=`${data.region || ''} · ${data.country_code || data.country || ''}`;if(coordinates)coordinates.textContent=`${Math.abs(lat).toFixed(2)}° ${lat >= 0 ? 'N' : 'S'} / ${Math.abs(lon).toFixed(2)}° ${lon >= 0 ? 'E' : 'W'}`;if(zone)zone.textContent=data.timezone || 'IP TIMEZONE';if(localTime&&data.timezone){localTime.dataset.timezone=data.timezone;clock();}status.textContent='IP 定位已更新 · GeoJS JSONP';delete (window as any)[callback];script.remove();};(window as any)[callback]=finish;script.src=`https://get.geojs.io/v1/ip/geo.js?callback=${callback}`;script.onerror=()=>{delete (window as any)[callback];script.remove();};document.head.append(script);};jsonpLocation();
    }
    if(item.kind==='intro'){
      const avatar=content.querySelector<HTMLImageElement>('[data-profile-avatar]');
      if(avatar) avatar.onerror=()=>{avatar.hidden=true;};
    }
    if(item.kind==='contact'){
      const brands=['bilibili','github','steam'];
      content.querySelectorAll<SVGElement>('.contact-icon').forEach((old,index)=>{const img=document.createElement('img');img.className='contact-icon';img.src=`https://cdn.simpleicons.org/${brands[index]}/e7c164`;img.alt=old.getAttribute('aria-label') || brands[index];img.loading='lazy';old.replaceWith(img);});
    }
    function bind(control:HTMLElement, resizing:boolean) {
      control.addEventListener('pointerdown', e=>{if(e.button!==0)return;e.preventDefault();control.setPointerCapture(e.pointerId);el.style.zIndex=String(++topLayer);el.classList.add('is-active'); const start={...item},sx=e.clientX,sy=e.clientY;
        const move=(ev:PointerEvent)=>{const dx=ev.clientX-sx,dy=ev.clientY-sy;if(resizing){item.w=Math.min(800,Math.max(260,start.w+dx));item.h=Math.min(700,Math.max(250,start.h+dy));}else{item.x=Math.min(2000,Math.max(0,start.x+dx));item.y=Math.min(2000,Math.max(0,start.y+dy));}position(el,item);extent();};
        const end=()=>{control.removeEventListener('pointermove',move);control.removeEventListener('pointerup',end);control.removeEventListener('pointercancel',end);el.classList.remove('is-active');save();};control.addEventListener('pointermove',move);control.addEventListener('pointerup',end);control.addEventListener('pointercancel',end);
      });
      control.addEventListener('keydown',e=>{if(!['ArrowLeft','ArrowRight','ArrowUp','ArrowDown'].includes(e.key))return;e.preventDefault();const dx=e.key==='ArrowLeft'?-8:e.key==='ArrowRight'?8:0,dy=e.key==='ArrowUp'?-8:e.key==='ArrowDown'?8:0;if(resizing){item.w=Math.max(260,Math.min(800,item.w+dx));item.h=Math.max(250,Math.min(700,item.h+dy));}else{item.x=Math.max(0,Math.min(2000,item.x+dx));item.y=Math.max(0,Math.min(2000,item.y+dy));}position(el,item);extent();save();});
    }
    bind(handle,false);bind(resize,true);clock();
  }
  function add(kind:Kind,x=40+items.length*24,y=40+items.length*24,parentId?:string){if(items.length>=20){status.textContent='最多放置 20 个控件';return;}const item={id:crypto.randomUUID(),kind,x:Math.max(0,x),y:Math.max(0,y),w:kind==='intro'?440:kind==='contact'?390:360,h:kind==='location'?320:kind==='intro'?310:kind==='contact'?230:290,parentId};items.push(item);mount(item);extent();save();}
  document.querySelectorAll<HTMLButtonElement>('[data-add]').forEach(button=>{button.onclick=()=>add(button.dataset.add as Kind);button.ondragstart=e=>{e.dataTransfer?.setData('text/plain',button.dataset.add!);};});
  canvas.ondragover=e=>{e.preventDefault();};canvas.ondrop=e=>{e.preventDefault();const kind=e.dataTransfer?.getData('text/plain');if(kind==='location'||kind==='quote'||kind==='intro'||kind==='contact'){const target=(e.target as HTMLElement).closest<HTMLElement>('[data-item-kind="intro"]');const r=canvas.getBoundingClientRect();const parentId=kind==='contact'&&target ? target.dataset.itemId : undefined;add(kind,e.clientX-r.left,e.clientY-r.top,parentId);if(parentId)status.textContent='联系我已嵌入个人简介';}};
  document.querySelector<HTMLButtonElement>('[data-reset]')!.onclick=()=>{canvas.querySelectorAll('.workspace-widget').forEach(el=>el.remove());items=defaults();items.forEach(mount);extent();save();};
  items.forEach(mount);extent();window.setInterval(clock,30000);
</script>

<style>
  .editor{background:#161719;color:#dbdbd5;min-height:100svh;font-family:Inter,'Segoe UI','Microsoft YaHei',sans-serif;display:flex;flex-direction:column}.editor button{cursor:pointer}.editor button:focus-visible{outline:2px solid #e8c362;outline-offset:-2px}.editor-bar{height:62px;display:flex;align-items:center;justify-content:space-between;padding:0 22px;background:#222325;border-bottom:1px solid #393a3b;font-size:13px}.editor-bar>div{display:flex;align-items:center;gap:15px}.editor-logo{background:#e8c362;color:#262626;padding:5px 8px;border-radius:4px;font-weight:800}.editor-divider{color:#737475}.editor-bar button{background:#303133;border:1px solid #464749;border-radius:4px;color:#ddd;padding:9px 12px}.editor-body{display:flex;flex:1;min-height:calc(100svh - 96px)}.library{position:relative;width:230px;flex-shrink:0;border-right:1px solid #363739;background:#202123;padding:23px 14px}.library h2{font-size:14px;margin:0 0 10px;display:flex;justify-content:space-between}.library h2 span{font:11px monospace;color:#a4a59e}.library>p{font-size:12px;color:#a4a59e;margin-bottom:25px}.library-item{width:100%;display:flex;align-items:center;gap:11px;padding:15px 10px;margin-bottom:10px;background:#2a2b2d;border:1px solid #3f4042;border-radius:5px;color:#e8e8e2;text-align:left}.library-item:hover{border-color:#b79b50;background:#31312b}.library-icon{font-size:26px;color:#e7c164;width:28px;text-align:center}.library-item strong{display:block;font-size:13px}.library-item small{display:block;font-size:11px;margin-top:6px;color:#aeb0a8}.library-item b{margin-left:auto;color:#b8b9b1}.library-note{margin-top:65px;padding:12px 4px;border-top:1px solid #393a3c;font-size:12px;line-height:1.9;color:#92958d}.workspace-shell{min-width:0;flex:1;display:flex;flex-direction:column}.workspace-tab{height:43px;display:flex;align-items:center;justify-content:space-between;background:#252628;border-bottom:1px solid #3a3b3d;font-size:12px}.workspace-tab>span{height:100%;padding:13px 22px;bo